  m_Script: {fileID: 11500000, guid: d0e06f179b05a9346a618d4dc0a79844, type: 3}
  m_Name: FirstTutorial
  m_EditorClassIdentifier: Assembly-CSharp::FoolsBrand.UI.TutorialSequence
  <Tutorials>k__BackingField:
  - <AdvanceCondition>k__BackingField: 0
    <TutorialText>k__BackingField: Welcome, debtor to the casino's arena! Here you
      will fight various monsters for our patrons' entertainment until you've worked
      off your debt.
  - <AdvanceCondition>k__BackingField: 0
    <TutorialText>k__BackingField: Don't worry though, we'll start you off with some
      weak Cylimes while you get the hang of things. Can't have you dying before
      we get our money's worth, after all!
